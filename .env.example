# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# /api/report 레이트리밋 카운터(report_usage) 기록용 — 서버에서만 쓰이며 RLS를 우회하는
# 강한 키다. 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것. 미설정 시 레이트리밋이 비활성화되고
# (프로덕션에서는 매 호출 error 로그) 공개 엔드포인트가 무제한 노출된다.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# 게스트 IP를 해시할 때 섞는 솔트(선택). 미설정 시 service role 키를 솔트로 쓴다.
# RATE_LIMIT_SALT=any_random_string

# 공공데이터포털 (https://www.data.go.kr)
# 아래 4개 서비스 신청 후 발급받은 키를 입력 (계정당 인증키 1개가 모든 서비스에 공통 — 동일한 키 사용 가능)
# - 기상청_단기예보 조회서비스           → KMA_API_KEY (/api/weather)
# - 기상청_생활기상지수 조회서비스(3.0)   → KMA_API_KEY (/api/uv, 자외선지수)
# - 한국환경공단_에어코리아_대기오염정보  → AIRKOREA_API_KEY (/api/air)
# - 기상청_꽃가루농도위험지수 조회서비스(3.0) → POLLEN_API_KEY (/api/pollen)
KMA_API_KEY=your_data_go_kr_api_key
AIRKOREA_API_KEY=your_data_go_kr_api_key
POLLEN_API_KEY=your_data_go_kr_api_key

# Anthropic (https://console.anthropic.com)
# AI 게이트웨이 사용 시: ANTHROPIC_API_KEY에 게이트웨이 발급 키를 넣고,
# ANTHROPIC_BASE_URL에 게이트웨이 엔드포인트를 설정 (미설정 시 Anthropic 기본 주소 사용)
# 주의: 게이트웨이는 Anthropic Messages API 호환(패스스루)이어야 하며,
#       게이트웨이 사용 시 실제 sk-ant- 키를 남겨두지 말 것 (게이트웨이 운영자에게 키가 노출됨)
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
